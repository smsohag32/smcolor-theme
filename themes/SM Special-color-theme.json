{
   "name": "SM Special",
   "type": "dark",
   "colors": {
      "editor.foreground": "#C8D6F5",
      "editor.background": "#0B1220",
      "editorCursor.foreground": "#FFCC00",
      "editor.lineHighlightBackground": "#0F1724",
      "editor.selectionBackground": "#24303B",
      "editor.inactiveSelectionBackground": "#1B2229",
      "editor.selectionHighlightBackground": "#2A3A47",
      "editorIndentGuide.background": "#1B2A36",
      "editorIndentGuide.activeBackground": "#2B4154",
      "editorWhitespace.foreground": "#2C3A45",
      "activityBar.background": "#071017",
      "sideBar.background": "#071017",
      "statusBar.background": "#061014",
      "titleBar.activeBackground": "#071017",
      "badge.background": "#0A66FF",
      "button.background": "#0A66FF",
      "editorGroupHeader.tabsBackground": "#071017",
      "tab.activeBackground": "#071017",
      "tab.inactiveBackground": "#061014",
      "panel.background": "#071017"
   },
   "tokenColors": [
      {
         "scope": ["comment", "punctuation.definition.comment", "string.comment"],
         "settings": {
            "foreground": "#5C6B73",
            "fontStyle": "italic"
         }
      },
      {
         "scope": ["keyword", "storage.type", "storage.modifier"],
         "settings": {
            "foreground": "#FF86A3",
            "fontStyle": "bold"
         }
      },
      {
         "scope": ["constant", "constant.numeric", "constant.language", "variable.other.constant"],
         "settings": {
            "foreground": "#FFD580"
         }
      },
      {
         "scope": ["string", "constant.other.symbol"],
         "settings": {
            "foreground": "#7EE787"
         }
      },
      {
         "scope": ["variable", "identifier", "support.variable", "meta.property-name"],
         "settings": {
            "foreground": "#C8D6F5"
         }
      },
      {
         "scope": ["variable.function", "entity.name.function", "support.function"],
         "settings": {
            "foreground": "#7CC8FF"
         }
      },
      {
         "scope": ["entity.name.type", "support.type", "storage.type.class"],
         "settings": {
            "foreground": "#FFD580"
         }
      },
      {
         "scope": ["punctuation", "meta.brace", "meta.delimiter"],
         "settings": {
            "foreground": "#ABB6C2"
         }
      },
      {
         "scope": ["invalid", "invalid.deprecated"],
         "settings": {
            "foreground": "#FFFFFF",
            "background": "#FF4D4F"
         }
      }
   ]
}
